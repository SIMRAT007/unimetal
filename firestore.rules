rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmail() {
      let setup = get(/databases/$(database)/documents/config/setup);
      return setup != null ? setup.data.adminEmail : null;
    }

    // The setup doc can be created by any authenticated user exactly once,
    // then only the stored admin can update it.
    match /config/setup {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.email == resource.data.adminEmail;
      allow delete: if false;
    }

    // Public read, admin-only write for all other content.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == adminEmail();
    }
  }
}
